{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "b3-floral-ebs",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-07-11",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "NOTION_PRODUCTION_DATABASE_ID": "3ce1c942022e80ecad54d11bdfa8ecbb",
    "NOTION_OWNER_DASHBOARD_PAGE_ID": "3ce1c942022e8090acd9fead57ccf753"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "b3-floral-ebs",
      "database_id": "5a28a3d1-9e14-4b99-993b-7cee7f4d0d4e",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STOCK_PHOTOS",
      "bucket_name": "b3-floral-stock-photos",
      "preview_bucket_name": "b3-floral-stock-photos-preview"
    }
  ]
}
